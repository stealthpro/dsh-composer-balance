{
  "name": "@stealthpro/dsh-composer-balance",
  "version": "1.2.0",
  "description": "Shows the remaining DeepSeek account balance under the message composer, with a details popover and a peak/off-peak pricing badge",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "balance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealthpro/dsh-composer-balance.git"
  },
  "homepage": "https://github.com/stealthpro/dsh-composer-balance#readme",
  "bugs": {
    "url": "https://github.com/stealthpro/dsh-composer-balance/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
